# Copy to .env and fill in values

# PostgreSQL connection string (Neon recommended: https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT signing secret (generate with: openssl rand -hex 64)
JWT_SECRET=change_this_to_a_long_random_string

# Panel admin credentials
# Generate bcrypt hash: node -e "const b=require('bcryptjs'); console.log(b.hashSync('yourpassword', 12))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$example_hash_here

# Must match PLACEHOLDER_DEVICE_SECRET baked into APK
DEVICE_SECRET=change_this_to_a_random_secret

# Port (Render sets this automatically)
PORT=3000

NODE_ENV=development
